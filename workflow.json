    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a0000000-0000-4000-8000-000000000101",
              "name": "perfil_candidato",
              "value": "Substitua este texto pelo resumo do seu perfil profissional. Inclua: cargo atual e senioridade, anos de experiência, principais tecnologias e ferramentas que domina, experiências relevantes, formação e certificações. Quanto mais específico, melhor a análise da IA.",
              "type": "string"
            },
            {
              "id": "a0000000-0000-4000-8000-000000000102",
              "name": "nota_minima",
              "value": 70,
              "type": "number"
            },
            {
              "id": "a0000000-0000-4000-8000-000000000103",
              "name": "palavras_chave",
              "value": "erp, power bi, jira, servicenow, power automate, n8n, rpa, itsm, sql",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [

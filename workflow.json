            {
              "id": "a0000000-0000-4000-8000-000000000201",
              "leftValue": "={{ [$json.title, ...($json.labels || []).map(l => l.name ?? l), ...($json.keywords || [])].join(' ').toLowerCase().normalize('NFD').replace(/[\\u0300-\\u036f]/g, '').match(/\\b(remot[oa]?|remote|home ?office|brasil|brazil|anywhere)\\b/) !== null }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "type": "n8n-nodes-base.filter",
